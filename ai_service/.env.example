# The agent runs against a local Ollama server — no API key, no cost.
# Install Ollama (https://ollama.com) and pull a tool-capable model first:
#   ollama pull llama3.1:8b
# Smaller/faster alternative (less reliable at picking the right tool,
# see docs/architecture_and_planning.md §2.4): AI_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434
AI_MODEL=llama3.1:8b

# Optional override.
AI_SERVICE_PORT=5002

# Forwarded to the Product MCP server subprocess.
PRODUCT_API_URL=http://127.0.0.1:5001
DATABASE_URL=sqlite:///../backoffice/hbntory.db

# Only needed if product_mcp/ is not a sibling directory with its own .venv.
# PRODUCT_MCP_PYTHON=/path/to/product_mcp/.venv/bin/python
# PRODUCT_MCP_SERVER=/path/to/product_mcp/server.py
